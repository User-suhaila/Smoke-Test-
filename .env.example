# Copy this file to .env and fill in your values.
# .env is excluded from source control — never commit real credentials.

# Base URL of the application under test
BASE_URL=https://stg-genforms.mobilityeye.com/

# Login credentials (required)
USERNAME=your-email@example.com
PASSWORD=your-password-here

# Set to 'false' to run tests in headed mode (browser visible)
# Defaults to headless (true) when not set
HEADLESS=true
